# Copy this file to `.env.local` and fill in your own values.
# Real environment files are gitignored; only this template is tracked.

# --- Supabase ---------------------------------------------------------
# Project URL and anon key: Supabase dashboard -> Project Settings -> API.
# The anon key is public by design (it ships to the browser). Protect your
# data with Row Level Security policies, not by hiding the key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: Supabase dashboard -> Project Settings -> API.
# NEVER expose this to the browser. It bypasses Row Level Security entirely
# and is only used by the webhook routes in `app/api/webhooks/`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret used to authenticate the Supabase Database Webhooks that
# trigger push notifications. Set the same value in Supabase's webhook
# configuration (as a Bearer token) and here.
SUPABASE_WEBHOOK_SECRET=choose-a-long-random-string

# --- OneSignal (optional) --------------------------------------------
# Push notifications are optional. If these are unset, the app runs fine and
# simply never sends push notifications.
# Create a free app at https://onesignal.com and copy the App ID from
# Settings -> Platform.
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# OneSignal REST API key: OneSignal dashboard -> Settings -> API keys.
# Used server-side by the webhook routes only.
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
